# Site Tracker Configuration
# Copy this file to .env and adjust values as needed

# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_PATH=./data/site-tracker.db

# Crawler Configuration
MAX_CRAWL_DEPTH=3

# Maximum number of pages to crawl per site
# This limit prevents the crawler from running indefinitely on very large sites
# Examples:
#   - Small sites (< 100 pages): 100-200
#   - Medium sites (100-500 pages): 500-1000
#   - Large sites (500+ pages): 1000-5000
# For sites with 1600+ pages like oodles.com, set to 2000 or higher
MAX_PAGES_PER_SITE=500

# Request timeout in milliseconds
TIMEOUT_MS=30000

# User agent for crawler requests
USER_AGENT=SiteTracker/1.0 (Website Audit Bot)
